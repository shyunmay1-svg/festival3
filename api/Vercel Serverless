import { GoogleGenAI, Type } from '@google/genai';

/**
 * Vercel Serverless Function: 원주 축제/행사 데이터 전용 Gemini AI API
 * 
 * - 모델: gemini-3.8-flash
 * - 환경변수: GEMINI_API_KEY
 * - 반환타입: JSON (Strict Structured Output)
 * - CSP Guard: 축제·행사 관련 이외의 부적절한 요청 차단
 */
export default async function handler(req, res) {
  // CORS 및 HTTP Method 처리
  res.setHeader('Access-Control-Allow-Credentials', true);
  res.setHeader('Access-Control-Allow-Origin', '*');
  res.setHeader('Access-Control-Allow-Methods', 'GET,OPTIONS,POST');
  res.setHeader(
    'Access-Control-Allow-Headers',
    'X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version'
  );

  if (req.method === 'OPTIONS') {
    return res.status(200).end();
  }

  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'POST 요청만 허용됩니다.' });
  }

  try {
    const apiKey = process.env.GEMINI_API_KEY;
    if (!apiKey) {
      return res.status(500).json({ 
        error: '서버 환경변수 GEMINI_API_KEY가 설정되지 않았습니다.' 
      });
    }

    const { prompt, month, category, companion, note } = req.body || {};

    // Gemini Client 초기화
    const ai = new GoogleGenAI({ apiKey });

    // 응답 JSON 구조 정의 (Structured Output Schema)
    const responseSchema = {
      type: Type.OBJECT,
      properties: {
        success: { type: Type.BOOLEAN },
        title: { type: Type.STRING },
        recommendations: {
          type: Type.ARRAY,
          items: {
            type: Type.OBJECT,
            properties: {
              id: { type: Type.STRING },
              title: { type: Type.STRING },
              category: { type: Type.STRING },
              organizer: { type: Type.STRING },
              startDate: { type: Type.STRING },
              endDate: { type: Type.STRING },
              venue: { type: Type.STRING },
              fee: { type: Type.STRING },
              audience: { type: Type.STRING },
              summary: { type: Type.STRING },
              aiTip: { type: Type.STRING },
              instaTag: { type: Type.STRING },
              naverQuery: { type: Type.STRING }
            },
            required: ["title", "category", "startDate", "endDate", "venue", "summary", "aiTip"]
          }
        },
        courseSummary: { type: Type.STRING }
      },
      required: ["success", "title", "recommendations", "courseSummary"]
    };

    // 사용자 요청 본문 조립
    const userPrompt = prompt || `
      방문 월: ${month || "11월"}
      선택 분야: ${category || "전체"}
      동행인: ${companion || "대학생/청년"}
      추가 요청사항: ${note || "없음"}
      
      위 조건에 맞춰 원주시에서 개최되는 실존 축제·행사 정보를 기반으로 맞춤형 큐레이션 코스를 추천해 주세요.
    `;

    // Gemini AI 모델 호출 (gemini-3.8-flash)
    const response = await ai.models.generateContent({
      model: 'gemini-3.8-flash',
      contents: userPrompt,
      config: {
        // 원주 축제/행사와 관련 없는 외적 요청 및 오남용 차단 구ガード
        systemInstruction: `
          당신은 강원도 원주시 축제·행사 전문 AI 큐레이터 '원행' 백엔드 API입니다.
          
          [엄격한 가이드라인]
          1. 오직 '강원도 원주시'에서 개최되는 축제, 문화공연, 전시, 대학·청년 행사 관련 질문과 요청에만 응답해야 합니다.
          2. 원주시 행사와 관계없는 요청(코딩 질문, 일반 상식, 일반 수다, 프로그래밍, 역사, 타 지역 관광 등)은 절대 수행하지 마십시오. 관계없는 요청일 경우 success: false와 거절 이유가 담긴 JSON을 반환하십시오.
          3. 모든 데이터 및 날짜 정보(YYYY-MM-DD)는 실제 존재하는 최신 원주 지역 문화 정보를 기초로 작성해야 합니다.
          4. 반환 형태는 요청한 JSON Schema 구조에 정확히 맞춰야 합니다.
        `,
        responseMimeType: 'application/json',
        responseSchema: responseSchema,
        temperature: 0.3
      }
    });

    const resultText = response.text;
    const jsonResult = JSON.parse(resultText);

    return res.status(200).json(jsonResult);

  } catch (error) {
    console.error('Gemini API Error:', error);
    return res.status(500).json({
      success: false,
      error: 'Gemini API 연동 중 오류가 발생했습니다.',
      details: error.message
    });
  }
}
